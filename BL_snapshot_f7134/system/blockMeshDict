FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      blockMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

convertToMeters 1;

vertices
(
    (  0   0   0)    // 0
    (250   0   0)    // 1
    (250 250   0)    // 2
    (  0 250   0)    // 3
    (  0   0 200)    // 4
    (250   0 200)    // 5
    (250 250 200)    // 6
    (  0 250 200)    // 7
);

blocks
(
    hex (0 1 2 3 4 5 6 7) (50 50 40) simpleGrading (1 1 1)
);

boundary
(
    surface                    // z = 0
    {
        type wall;             // or symmetryPlane / slip for rigid lid
        faces ((0 1 2 3));
    }

    seabed                     // z = 200
    {
        type wall;
        faces ((4 5 6 7));
    }

    left                       // x = 0
    {
        type cyclic;
        neighbourPatch right;
        faces ((0 4 7 3));
    }

    right                      // x = 250
    {
        type cyclic;
        neighbourPatch left;
        faces ((1 2 6 5));
    }

);

