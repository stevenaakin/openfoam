5
(
    movingWall
    {
        type            wall;
        inGroups        List<word> 1(wall);
        nFaces          20;
        startFace       760;
    }
    bottomWall
    {
        type            wall;
        inGroups        List<word> 1(wall);
        nFaces          20;
        startFace       780;
    }
    cyc_half0
    {
        type            cyclic;
        inGroups        List<word> 1(cyclic);
        nFaces          20;
        startFace       800;
        matchTolerance  0.0001;
        neighbourPatch  cyc_half1;
        transformType   translational;
        separation      (-0.1 0 0);
    }
    cyc_half1
    {
        type            cyclic;
        inGroups        List<word> 1(cyclic);
        nFaces          20;
        startFace       820;
        matchTolerance  0.0001;
        neighbourPatch  cyc_half0;
        transformType   translational;
        separation      (0.1 0 0);
    }
    frontAndBack
    {
        type            empty;
        inGroups        List<word> 1(empty);
        nFaces          800;
        startFace       840;
    }
)

